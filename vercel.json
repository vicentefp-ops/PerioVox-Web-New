{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "redirects": [
    {"source": "/", "has": [{"type": "host", "value": "www.periovox.ai"}], "destination": "https://periovox.ai/", "permanent": true},
    {"source": "/:path*/", "has": [{"type": "host", "value": "www.periovox.ai"}], "destination": "https://periovox.ai/:path*/", "permanent": true},
    {"source": "/:path*", "has": [{"type": "host", "value": "www.periovox.ai"}], "destination": "https://periovox.ai/:path*", "permanent": true},
    {"source": "/", "has": [{"type": "cookie", "key": "pv_web_language", "value": "es"}], "destination": "/es/", "permanent": false},
    {"source": "/", "has": [{"type": "header", "key": "accept-language", "value": "^[eE][sS](?:-[A-Za-z0-9]+)*(?:[,;].*)?$"}], "missing": [{"type": "cookie", "key": "pv_web_language", "value": "en"}], "destination": "/es/", "permanent": false}
  ],
  "rewrites": [
    {"source": "/api/journal/:path*", "destination": "https://journal-backend.periovox.ai/api/journal/:path*"},
    {"source": "/journal/", "destination": "https://journal-backend.periovox.ai/journal/"},
    {"source": "/es/journal/", "destination": "https://journal-backend.periovox.ai/es/journal/"},
    {"source": "/journal/:path*/", "destination": "https://journal-backend.periovox.ai/journal/:path*/"},
    {"source": "/es/journal/:path*/", "destination": "https://journal-backend.periovox.ai/es/journal/:path*/"},
    {"source": "/journal/:path*", "destination": "https://journal-backend.periovox.ai/journal/:path*"},
    {"source": "/es/journal/:path*", "destination": "https://journal-backend.periovox.ai/es/journal/:path*"},
    {"source": "/journal-media/:path*", "destination": "https://journal-backend.periovox.ai/journal-media/:path*"},
    {"source": "/sitemap-journal.xml", "destination": "https://journal-backend.periovox.ai/sitemap-journal.xml"}
  ],
  "headers": [
    {"source": "/:path*", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}]}
  ]
}
