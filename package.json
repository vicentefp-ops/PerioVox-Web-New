{
  "name": "periovox-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3200",
    "build": "vite build && vite build --ssr src/journal-entry.tsx --outDir dist-server && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 3201",
    "lint": "tsc --noEmit",
    "seo:check": "node scripts/check-seo.mjs && node scripts/check-analytics.mjs",
    "start": "node server/serve.mjs",
    "journal:setup": "node server/setup-journal.mjs",
    "journal:check": "node --test server/journal.test.mjs server/journal-metadata.test.mjs server/journal-editor.test.mjs server/journal-admin.test.mjs server/journal-bootstrap.test.mjs",
    "build:vercel": "npm run build && node scripts/prepare-vercel.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "lucide-react": "^0.546.0",
    "marked": "^17.0.6",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": "24.x"
  }
}
